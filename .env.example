# ---------------------------------------------------------------------------
# Atlas environment variables
#
# Variables prefixed with VITE_ are compiled into the browser bundle and are
# therefore PUBLIC. Only put values there that are safe for anyone to read.
# ---------------------------------------------------------------------------

# Supabase project URL and anon (public) key. Safe for the browser: all data
# access is constrained by Row Level Security and Storage policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# MapLibre style URL. Defaults to OpenFreeMap "positron" (no key required).
# To use a keyed provider (e.g. MapTiler), put the full style URL including
# its *public, domain-restricted* key here.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Optional geocoder endpoint (Photon-compatible API). Defaults to the public
# Photon instance by Komoot; please respect its fair-use policy.
VITE_GEOCODER_URL=https://photon.komoot.io/api/

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — never prefix with VITE_, never commit real values.
# Set these as Supabase Edge Function secrets:
#   supabase secrets set TICKETMASTER_API_KEY=...
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically into
# deployed Edge Functions by Supabase.
# ---------------------------------------------------------------------------
# TICKETMASTER_API_KEY=        (Ticketmaster *Consumer Key*, not the Consumer Secret)
# ATLAS_ALLOWED_ORIGINS=       (optional CORS allow-list for discover-events, e.g. https://atlas.example)
#
# Live integration tests read dedicated test accounts from .env.live.local,
# generated by `npm run test:live:provision` (gitignored; never commit it).
