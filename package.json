{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/db",
    "seed:generate": "node scripts/generate-seed.mjs",
    "test:e2e": "playwright test",
    "test:live": "vitest run -c vitest.live.config.ts",
    "test:live:provision": "node scripts/live/provision-test-users.mjs",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "types:generate": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts.tmp && (echo '// GENERATED by `supabase gen types typescript --linked --schema public` — do not edit by hand.'; cat src/lib/database.types.ts.tmp) > src/lib/database.types.ts && rm src/lib/database.types.ts.tmp",
    "storage:orphans:report": "bash scripts/storage-orphans-report.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "framer-motion": "^14.1.0",
    "lucide": "^1.54.0",
    "lucide-react": "^1.54.0",
    "maplibre-gl": "^6.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  }
}
